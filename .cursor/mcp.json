{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "shaders": {
      "type": "http",
      "url": "https://shaders.com/mcp"
    },
    "motion-dev": {
      "command": "npx",
      "args": [
        "-y",
        "motion-ai"
      ],
      "env": {
        "MOTION_TOKEN": "${MOTION_TOKEN}"
      }
    },
    "icons8mcp": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.icons8.com/mcp/"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
