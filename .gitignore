# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# large source media — keep local; optimized square versions live in /public/video/3d
/public/video/*.mp4
/public/images/Gemini_Generated_Image_*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# local development
/.claude
/.idea
/.agent
/.agents

# test artifacts & MCP scratch (never commit — regenerated on every run)
/output/
/.playwright-mcp/
/.playwright-cli/
/test-results/
/playwright-report/
/variant_b_*.png

# large 3D binaries — keep local until tracked via Git LFS (e.g. altyn_adam.glb ~44MB)
/public/models/
