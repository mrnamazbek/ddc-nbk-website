  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/security.spec.ts --project=chromium",
    "check:deps": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run test:unit && npm run check:deps"
  },
  "dependencies": {
