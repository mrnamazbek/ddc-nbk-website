# Never commit real credentials. Configure production values in Vercel instead.
# Contact delivery uses a verified sender from Resend, or an HTTPS corporate webhook.
CONTACT_RECIPIENT_EMAIL=info@ddc.nationalbank.kz
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=

# Optional local-only credentials for approved asset discovery tools. They are
# not read by the deployed application and must never use NEXT_PUBLIC_*.
MOTION_TOKEN=
ICONSCOUT_CLIENT_ID=
ICONSCOUT_CLIENT_SECRET=
ICONS8_API_KEY=
